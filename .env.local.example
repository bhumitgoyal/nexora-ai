# Resend API key — get one at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Contact form routing (optional).
# CONTACT_FROM_EMAIL must be on a domain verified at resend.com/domains.
# Until a domain is verified, Resend's test sender only delivers to the
# Resend account owner's own address.
CONTACT_FROM_EMAIL="Nuvero AI <noreply@nuvero.space>"
CONTACT_TO_EMAIL=nuveroai@gmail.com
